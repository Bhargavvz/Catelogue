# ─────────────────────────────────────────────────────────────────────────────
# Everything here is optional.
#
# With none of it set, the site builds and serves from src/content/seed.ts:
# every page renders, the catalogue works, the GitHub telemetry falls back to
# the public events feed. What you lose is the CMS, the inbox, the counters and
# the reader stats. Add variables as you turn each piece on.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase, browser side ───────────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app → Config.
# These are public by design; Firestore security rules are what protect data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase, server side ────────────────────────────────────────────────────
# Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or base64 it if your host mangles newlines.
# NEVER prefix this with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternative to the JSON blob above — set all three instead.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Who owns /admin ──────────────────────────────────────────────────────────
# Create the user in Firebase console → Authentication → Users, then put the
# UID here. Without one of these, every admin API call is refused — being signed
# in to the Firebase project is not by itself authorisation.
ADMIN_UID=
ADMIN_EMAIL=

# ── GitHub telemetry ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GITHUB_USER=bhargavvz
# A classic token with no scopes (public data only) is enough. Without it the
# activity chart falls back to ~90 days of public events and says so on the page.
GITHUB_TOKEN=

# ── Contact notifications (optional) ─────────────────────────────────────────
# Messages always land in Firestore. These only add an email ping on top.
RESEND_API_KEY=
RESEND_FROM_EMAIL=portfolio@yourdomain.com
CONTACT_NOTIFY_EMAIL=bhargavadepu@outlook.com
